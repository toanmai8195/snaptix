# Cấu hình Bazel (bzlmod) cho toàn bộ Go trong com/tm/server.
# Phiên bản Bazel: .bazelversion (8.7.0).

module(name = "snaptix_server")

# rules_go: dạy Bazel build/test Go. gazelle: sinh BUILD.bazel từ code Go.
bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")

# platforms: constraint chuẩn (@platforms//os:linux, @platforms//cpu:arm64...) để khai báo nền tảng đích.
bazel_dep(name = "platforms", version = "1.0.0")

# bazel_skylib: copy_file (đưa binary ra đường dẫn ổn định trong image).
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# Bazel tự tải Go SDK riêng (không dùng Go cài trên máy) → mọi máy build cùng một phiên bản.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.1")

# Dependency Go lấy từ go.mod — không khai báo lại ở đây.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_go_chi_chi_v5", "com_github_jackc_pgx_v5")

# =============================================================================
# OCI / CONTAINER (giống thor; rules_oci + tar.bzl chưa hỗ trợ Bazel 9)
# =============================================================================
# rules_oci ghép image từ layer tar + config, không cần Docker daemon, không Dockerfile.
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "tar.bzl", version = "0.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Base cho Go: distroless static — không shell, không libc (Go build tĩnh), user nonroot 65532.
# Pin theo DIGEST (image index multi-arch): tag có thể bị trỏ sang image khác, digest thì không.
#   docker buildx imagetools inspect gcr.io/distroless/static-debian12:nonroot
oci.pull(
    name = "distroless_static",
    digest = "sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab",
    image = "gcr.io/distroless/static-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64", "distroless_static_linux_arm64_v8")
