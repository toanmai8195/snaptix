load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//tools/rules:com_tm_container.bzl", "com_tm_go_image")

go_library(
    name = "server_lib",
    srcs = [
        "config.go",
        "main.go",
    ],
    importpath = "github.com/toanmai8195/snaptix/com/tm/server/services/core/cmd/server",
    visibility = ["//visibility:private"],
    deps = [
        "//services/core/internal/httpx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

# Binary + image: :server, :server_image, :server_docker (tag com.tm.go.core-server:v1.0.0)
#   bazel run --config=linux-arm64 //services/core/cmd/server:server_docker
com_tm_go_image(
    name = "server",
    embed = [":server_lib"],
    exposed_ports = ["8080/tcp"],
    image_name = "core-server",
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = [
        "config_test.go",
        "main_test.go",
    ],
    embed = [":server_lib"],
)
