# In lệnh lỗi đầy đủ khi build fail
build --verbose_failures
# Test fail thì in output của test
test --test_output=errors

# Go thuần, tắt CGO: không cần C compiler / Xcode, binary tĩnh chạy được trên image tối giản
build --@rules_go//go/config:pure
build --action_env=CGO_ENABLED=0
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# rules_oci (như thor): CopyFile / CopyToDirectory không chạy được trong darwin-sandbox → chạy local
build --strategy=CopyFile=local
build --strategy=CopyToDirectory=local
# rules_oci: không đọc Docker credentials trong ~/.docker/config.json (base image là public)
build --repo_env=DOCKER_CONFIG=/dev/null

# Build chéo cho Linux (image, server). Không đặt → build cho máy đang chạy (macOS khi dev).
#   bazel build --config=linux-arm64 //...   # Apple Silicon, server ARM
#   bazel build --config=linux-amd64 //...   # server x86
build:linux-arm64 --platforms=//:linux_arm64
build:linux-amd64 --platforms=//:linux_amd64

# Cấu hình cá nhân (không commit)
try-import %workspace%/.bazelrc.user
