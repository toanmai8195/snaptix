common --enable_bzlmod

# -----------------------------------------------------------------------------
# Build
# -----------------------------------------------------------------------------
build --verbose_failures
build --spawn_strategy=sandboxed

# macOS: không cần Xcode / C++ toolchain (Go pure, CGO tắt)
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --@rules_go//go/config:pure
build --action_env=CGO_ENABLED=0

# rules_oci: CopyToDirectory / CopyFile không chạy được trong darwin-sandbox
build --strategy=CopyToDirectory=local
build --strategy=CopyFile=local

# rules_oci: không đọc Docker credentials từ ~/.docker/config.json khi pull base image
build --repo_env=DOCKER_CONFIG=/dev/null

test --test_output=errors

# -----------------------------------------------------------------------------
# Image theo kiến trúc máy chạy container
#   bazel run --config=linux-arm64 //path:<name>_docker   (Mac Apple Silicon)
#   bazel run --config=linux-amd64 //path:<name>_docker   (server x86)
# -----------------------------------------------------------------------------
build:linux-amd64 --platforms=//:linux_amd64
build:linux-arm64 --platforms=//:linux_arm64

# -----------------------------------------------------------------------------
# Profile
# -----------------------------------------------------------------------------
build:release --compilation_mode=opt
build:release --strip=always

# Cấu hình cá nhân (không commit)
try-import %workspace%/.bazelrc.user
